Host *
ServerAliveInterval 30
ControlMaster auto
ControlPath ~/.ssh/master-%r@%h:%p
ControlPersist yes

# 默认账户（个人）
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_rsa  # 默认密钥

# 第二个账户（公司/其他）
Host github.com-second
  HostName github.com
  User git
  IdentityFile ~/.ssh/github_account2  # 第二个密钥 